
class Solution {

    int[] parent;

    int find(int x) {

        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }

        return parent[x];
    }

    public int[] findRedundantDirectedConnection(int[][] edges) {

        int n = edges.length;

        int[] parentNode = new int[n + 1];

        int[] candidate1 = new int[2];
        int[] candidate2 = new int[2];

        
        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            if (parentNode[v] == 0) {

                parentNode[v] = u;

            } else {

                candidate1 = new int[]{parentNode[v], v};
                candidate2 = new int[]{u, v};

               
                edge[1] = 0;
            }
        }

        
        parent = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            parent[i] = i;
        }

       
        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            if (v == 0) {
                continue;
            }

            int rootU = find(u);
            int rootV = find(v);

            if (rootU == rootV) {

               
                if (candidate2[0] != 0) {
                    return candidate1;
                }

               
                return edge;
            }

            parent[rootV] = rootU;
        }

        
        return candidate2;
    }
}
