
class Solution {

    int[] parent;

    int find(int x) {

        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }

        return parent[x];
    }

    public int[] findRedundantConnection(int[][] edges) {

        int n = edges.length;

        parent = new int[n + 1];

        // Initially, every node is its own parent
        for (int i = 1; i <= n; i++) {
            parent[i] = i;
        }

        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            int rootU = find(u);
            int rootV = find(v);

            // Both nodes already belong to same component
            if (rootU == rootV) {
                return edge;
            }

            // Merge components
            parent[rootU] = rootV;
        }

        return new int[0];
    }
}
